# Neon Postgres (isi setelah buat database di https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.neon.tech/dbname?sslmode=require"

# URL publik situs (dipakai untuk canonical/absolute URL)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Token proteksi API dashboard — dipakai nanti saat wiring DB (jangan commit nilai asli)
ADMIN_TOKEN="ganti-dengan-token-acak-min-32-karakter"

